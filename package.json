{
  "name": "geoconversion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run check && npm test && node scripts/revision.mjs && vite build",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.195.0",
    "@js-temporal/polyfill": "^0.5.1",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
